# Supabase — pegue em: Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:[senha]@db.[seu-projeto].supabase.co:5432/postgres"

# OpenAI — pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# JWT — qualquer string longa e aleatória (ex: gere em https://generate-secret.vercel.app/32)
JWT_SECRET="troque-por-uma-string-secreta-aleatoria"
